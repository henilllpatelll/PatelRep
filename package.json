{
  "name": "patelrep",
  "private": true,
  "scripts": {
    "postinstall": "npx patch-package || true",
    "setup:hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-push && echo 'Git hooks configured.'",
    "db:check": "node scripts/check-migrations.mjs",
    "db:rebuild": "node scripts/db-rebuild.mjs",
    "db:contracts": "node scripts/db-contracts.mjs",
    "db:inventory": "node scripts/migration-inventory.mjs",
    "db:drift:staging": "node scripts/check-db-drift.mjs --environment staging",
    "db:drift:production": "node scripts/check-db-drift.mjs --environment production",
    "db:test": "node --test scripts/check-migrations.test.mjs scripts/check-db-drift.test.mjs scripts/staging-target-guard.test.mjs scripts/production-target-guard.test.mjs scripts/check-feature-flag-registry.test.mjs scripts/public-smoke.test.mjs scripts/release-content-summary.test.mjs",
    "feature-flags:check-registry": "node scripts/check-feature-flag-registry.mjs",
    "ship": "node scripts/ship.mjs",
    "build": "cd apps/web && npm run build",
    "start": "cd apps/web && npm run start",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && .venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 8003",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "ab:auth": "powershell -ExecutionPolicy Bypass -File e2e/agent-browser/scripts/auth-setup.ps1",
    "ab:baseline": "powershell -ExecutionPolicy Bypass -File e2e/agent-browser/scripts/visual-baseline.ps1",
    "ab:compare": "powershell -ExecutionPolicy Bypass -File e2e/agent-browser/scripts/visual-compare.ps1",
    "ab:flows": "powershell -ExecutionPolicy Bypass -File e2e/agent-browser/scripts/e2e-flows.ps1",
    "ab:test": "powershell -ExecutionPolicy Bypass -File e2e/agent-browser/scripts/run-all.ps1"
  },
  "dependencies": {
    "expo": "^46.0.21",
    "patch-package": "^8.0.1",
    "@types/react": "~18.0.0",
    "@types/react-native": "~0.69.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
