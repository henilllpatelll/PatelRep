FROM node:20-alpine AS deps
WORKDIR /app
COPY apps/web/package.json ./
RUN npm install

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
# NEXT_PUBLIC_* vars are baked into the JS bundle at build time, not runtime.
# They must be passed as Docker build args so next build can inline them.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_APP_ENV
ARG NEXT_PUBLIC_RELEASE_SHA
ARG NEXT_PUBLIC_RELEASE_VERSION
ARG STAGING_EXPECTED_API_HOST
ARG STAGING_EXPECTED_SUPABASE_HOST
ARG PRODUCTION_API_HOST
ARG PRODUCTION_SUPABASE_HOST
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_RELEASE_SHA=$NEXT_PUBLIC_RELEASE_SHA
ENV NEXT_PUBLIC_RELEASE_VERSION=$NEXT_PUBLIC_RELEASE_VERSION
ENV STAGING_EXPECTED_API_HOST=$STAGING_EXPECTED_API_HOST
ENV STAGING_EXPECTED_SUPABASE_HOST=$STAGING_EXPECTED_SUPABASE_HOST
ENV PRODUCTION_API_HOST=$PRODUCTION_API_HOST
ENV PRODUCTION_SUPABASE_HOST=$PRODUCTION_SUPABASE_HOST
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# With non-hoisted deps, standalone output is at .next/standalone/server.js (no nesting)
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public
USER node
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
