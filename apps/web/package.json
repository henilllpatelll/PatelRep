    "check:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "check:frozen-files": "node scripts/check-frozen-files.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:deployment-drift": "node scripts/check-deployment-drift.mjs",
    "test:unit": "tsx --test lib/utils/housekeepingBoardFilters.test.ts lib/utils/housekeepingDashboardMetrics.test.ts lib/utils/navigation.test.ts lib/utils/roomType.test.ts lib/utils/unifiedTasks.test.ts lib/utils/taskWorkspace.test.ts lib/utils/userGreeting.test.ts lib/utils/copilotRoute.test.ts"
  },
