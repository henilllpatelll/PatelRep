{
  "name": "@patelrep/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:e2e:phase1": "playwright test --config=playwright.phase1.config.ts",
    "test:e2e:phase4": "playwright test --config=playwright.phase4.config.ts",
