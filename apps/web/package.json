    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-i18next": "^6.1.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.4",
