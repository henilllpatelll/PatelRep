# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=your-jwt-secret

# AI
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Opera Cloud (OHIP)
OPERA_OAUTH_CLIENT_ID=your-client-id
OPERA_OAUTH_CLIENT_SECRET=your-client-secret
OPERA_OAUTH_BASE_URL=https://api.oracle.com
OPERA_APP_KEY=your-oracle-application-key
OPERA_ENTERPRISE_ID=
OPERA_CREDENTIAL_ENCRYPTION_KEY=generate-with-Fernet.generate_key

# Internal
CRON_SECRET=your-random-32-char-secret
APP_ENV=development
RELEASE_SHA=unknown
RELEASE_VERSION=unknown
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
# Required when APP_ENV=staging. Hostnames only; never put keys here.
STAGING_EXPECTED_SUPABASE_HOST=staging-project.supabase.co
PRODUCTION_SUPABASE_HOST=production-project.supabase.co
# Keep Opera/OHIP/SFTP disabled in staging unless using a dedicated vendor sandbox.
STAGING_EXTERNAL_INTEGRATIONS_ENABLED=false
