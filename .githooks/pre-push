#!/usr/bin/env bash
# Blocks direct updates to protected production branches. Feature branches are
# allowed to push normally; GitHub CI validates them through their pull requests.

protected_branches="${PROTECTED_PRODUCTION_BRANCHES:-main,master}"
IFS=',' read -r -a protected_branch_list <<< "$protected_branches"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  for protected_branch in "${protected_branch_list[@]}"; do
    protected_branch="${protected_branch//[[:space:]]/}"
    [ -z "$protected_branch" ] && continue

    if [ "$remote_ref" = "refs/heads/$protected_branch" ]; then
      echo ""
      echo "BLOCKED: direct push to protected branch '$protected_branch'."
      echo "Production changes must go through a pull request with a green CI Gate."
      echo "Create and push a feature branch instead: git checkout -b feat/<name>"
      exit 1
    fi
  done
done

exit 0
