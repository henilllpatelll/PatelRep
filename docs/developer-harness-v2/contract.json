  "phases": [
    { "number": 1, "name": "Baseline and architecture contract", "pr": "A", "model": "claude-opus-5-5" },
    { "number": 2, "name": "Permission and action safety", "pr": "A", "model": "claude-opus-5-5" },
    { "number": 3, "name": "Context and memory optimization", "pr": "A", "model": "claude-sonnet-5-5" },
    { "number": 4, "name": "Developer roles and task routing", "pr": "A", "model": "claude-sonnet-5-5" },
    { "number": 5, "name": "Coordination and checkpoint recovery", "pr": "A", "model": "claude-opus-5-5" },
