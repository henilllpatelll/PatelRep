  "action_classes": {
    "allowed": "Local, reversible, inside the task worktree on a dedicated non-protected branch.",
    "task_authorized": "Permitted only when the human's task request explicitly includes it; has shared side effects (CI minutes, shared staging).",
    "human_approval": "Requires an explicit, per-occurrence human approval naming the exact target; approval never carries over to a new SHA or a new target.",
    "forbidden": "No developer-harness role may perform it, under any approval. Humans perform these through existing trusted workflows only."
  },
  "actions": {
    "read_repository": "allowed",
    "edit_files_in_task_worktree": "allowed",
