{
  "enabledPlugins": {
    "railway@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npm run type-check*)",
      "Bash(npm run test*)",
      "Bash(npm ci)",
      "Bash(npm install*)",
      "Bash(npx playwright test*)",
      "Bash(npx supabase*)",
      "Bash(cd apps/api && python*)",
      "Bash(cd apps/api && pip*)",
      "Bash(cd apps/api && ruff*)",
      "Bash(cd apps/api && pyright*)",
      "Bash(cd apps/mobile && npm*)",
      "Bash(cd apps/mobile && eas*)",
      "Bash(eas build*)",
      "Bash(eas update*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(railway logs*)",
      "Bash(railway status)",
      "Bash(node .wolf/hooks/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-hook.mjs\" wolf session-start",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-hook.mjs\" dev-servers",
            "async": true,
            "statusMessage": "Starting dev servers..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-hook.mjs\" wolf pre-read",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-hook.mjs\" wolf pre-write",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-hook.mjs\" wolf post-read",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-hook.mjs\" wolf post-write",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-hook.mjs\" wolf stop",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/local-hook.mjs\" graphify-update",
            "timeout": 120,
            "async": true,
            "statusMessage": "Updating knowledge graph..."
          }
        ]
      }
    ]
  }
}
